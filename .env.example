# Environment mode (development, production, testing)
APP_ENV=development
LOG_LEVEL=INFO

# Server configuration
HOST=0.0.0.0
PORT=8000
API_KEY=content_studio_secret_key

# Database (Async SQLite by default, or PostgreSQL)
DATABASE_URL=sqlite:///data/content_studio.db

# AI Engine (Google Gemini) - Optional: deterministic fallback enabled if absent
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
